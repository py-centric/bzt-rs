# pummel Environment Configuration
# Priority: CLI args > system env vars > .env file > defaults
#
# Variable naming: UPPER_SNAKE_CASE
# Sensitive variables go in config/secrets.env (see .gitignore)
#
# Application
APP_ENV=development

# Load test defaults (overridable by config file and CLI)
BZT_DEFAULT_CONCURRENCY=10
BZT_DEFAULT_RAMP_UP=30s
BZT_DEFAULT_HOLD_FOR=5m

# Debug
# BZT_DEBUG=true  # Enable verbose debug logging
